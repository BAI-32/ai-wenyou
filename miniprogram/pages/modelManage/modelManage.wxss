.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #e6d5a8;
}

.add-btn {
  font-size: 26rpx;
  padding: 8rpx 20rpx;
}

.config-card {
  background: #161625;
  border: 1rpx solid #2a2a3e;
  border-radius: 12rpx;
  padding: 30rpx;
  margin-bottom: 24rpx;
}

.config-card.default {
  border-color: #3a5a32;
  background: #1a2519;
}

.config-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.config-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #c9b878;
}

.default-tag {
  background: #3a5a32;
  color: #9cd08f;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.config-info {
  color: #999;
  font-size: 26rpx;
  line-height: 1.8;
  margin-bottom: 20rpx;
}

.config-actions {
  display: flex;
  gap: 16rpx;
}

.config-actions button {
  font-size: 24rpx;
  padding: 6rpx 20rpx;
}

.empty {
  text-align: center;
  margin-top: 150rpx;
}

.empty-text {
  display: block;
  color: #666;
  font-size: 28rpx;
  margin-bottom: 20rpx;
}

.hint {
  color: #558844;
  font-size: 24rpx;
}

.modal {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 90%;
  max-height: 80vh;
  overflow-y: auto;
  background: #161625;
  border-radius: 16rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.modal-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 40rpx;
  font-size: 34rpx;
  font-weight: bold;
  color: #e6d5a8;
}

.close-btn {
  font-size: 48rpx;
  color: #999;
}

.form-item {
  margin-bottom: 30rpx;
}

.label {
  display: block;
  font-size: 28rpx;
  color: #ccc;
  margin-bottom: 12rpx;
}

.input-field {
  width: 100%;
  box-sizing: border-box;
  background: #1a1a2e;
  border: 1rpx solid #3a3a5e;
  border-radius: 8rpx;
  padding: 20rpx;
  color: #e0e0e0;
  font-size: 28rpx;
}

slider {
  margin: 10rpx 0;
}

.form-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.form-actions button {
  flex: 1;
}

.container {
  padding: 30rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

.header {
  text-align: center;
  margin: 40rpx 0;
}

.title {
  font-size: 40rpx;
  font-weight: bold;
  color: #e6d5a8;
}

.form-item {
  margin-bottom: 40rpx;
}

.label {
  display: block;
  font-size: 30rpx;
  color: #ccc;
  margin-bottom: 16rpx;
}

.desc-input {
  min-height: 200rpx;
  width: 100%;
  box-sizing: border-box;
}

.hint {
  display: block;
  color: #666;
  font-size: 24rpx;
  margin-top: 12rpx;
}

.generate-btn {
  width: 100%;
}

.card-preview {
  margin-top: 60rpx;
  background: #161625;
  border: 1rpx solid #3a5a32;
  border-radius: 12rpx;
  padding: 30rpx;
}

.preview-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 30rpx;
}

.preview-title {
  font-size: 32rpx;
  font-weight: bold;
  color: #c9b878;
}

.edit-btn {
  font-size: 24rpx;
  padding: 4rpx 20rpx;
}

.info-row {
  margin-bottom: 16rpx;
  font-size: 28rpx;
}

.info-label {
  color: #9cd08f;
}

.info-desc {
  margin-bottom: 20rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #ccc;
}

.edit-area {
  width: 100%;
  min-height: 400rpx;
  box-sizing: border-box;
  font-family: monospace;
  font-size: 26rpx;
}

.preview-actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}

.preview-actions button {
  flex: 1;
}
